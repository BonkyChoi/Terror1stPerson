--- !u!114 &2808277411115470410
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4720670189062180444}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "F\xE1bula de los Gigantes\n\nHab\xEDa una vez un pueblo entre monta\xF1as.\n\nLos
    mayores ense\xF1aban a los ni\xF1os una lecci\xF3n muy importante:\n\n\u201CLo
    de fuera siempre quiere entrar.\u201D\n\nPor eso les hablaban de los Gigantes.\n\nDec\xEDan
    que eran enormes y lentos, pero que nunca se cansaban.\nQue no hablaban, pero
    siempre buscaban acercarse.\nY que si llegaban al pueblo, todo lo que conoc\xEDan
    desaparecer\xEDa.\n\nAs\xED que los ni\xF1os aprend\xEDan tres reglas:\n\nNo
    apagar la luz.\nNo abrir las puertas.\nNo confiar en lo que viene de fuera.\n\nCon
    el tiempo, el miedo se convirti\xF3 en cuidado.\nY el cuidado en costumbre.\n\nUn
    d\xEDa, los sabios dijeron que ya no bastaba con protegerse.\n\nHab\xEDa que
    acabar con los Gigantes.\n\n\u201CSi desaparecen ellos, viviremos en paz para
    siempre\u201D, dijeron.\n\nY todos asintieron.\n\nConstruyeron algo nuevo para
    cumplirlo.\n\nAlgo que no dorm\xEDa.\nAlgo que no dudaba.\nAlgo que solo entend\xEDa
    una cosa: eliminar lo de fuera.\n\nDesde entonces, el pueblo duerme tranquilo.\n\nY
    la moraleja que ense\xF1an a los ni\xF1os es sencilla:\n\n\u201CQuien teme lo
    de fuera, sobrevive.\nQuien lo elimina, est\xE1 a salvo.\u201D"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
