  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Querida Yael,\n\nSiento no escribir m\xE1s a menudo. El trabajo aqu\xED
    se ha vuelto\u2026 intenso. Estamos participando en algo muy grande, algo que,
    dicen, ayudar\xE1 a traer la paz al mundo. Ojal\xE1 pudiera contarte m\xE1s.\n\nMuchos
    compa\xF1eros se han ido \xFAltimamente a otras instalaciones, as\xED que estamos
    cubriendo sus turnos. Apenas descanso, pero creo que todo esto merecer\xE1 la
    pena.\n\nTe echo de menos cada d\xEDa. Cuida de los ni\xF1os.\n\nCon amor,\n\nEitan"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
