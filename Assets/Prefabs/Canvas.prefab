  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Oye, Amir,\n\nMe debes 300 de anoche. Perdiste en las cartas, no te hagas
    el loco.\n\nY hoy ya no est\xE1s. \u201CTraslado\u201D, dicen. Qu\xE9 conveniente.\n\nNo
    pasa nada. Donde sea que te hayan mandado, te voy a encontrar. Y no solo me vas
    a pagar lo que debes, tambi\xE9n los intereses por desaparecer as\xED.\n\nLa
    pr\xF3xima vez, paga antes de largarte.\n\n\u2014 David"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
