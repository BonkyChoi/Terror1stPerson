    m_PersistentCalls:
      m_Calls: []
  m_text: "Nota para el nuevo vigilante\n\nLa estructura de la celda est\xE1 vinculada
    al sistema de vigilancia.\n\nCualquier cambio en la orientaci\xF3n de las pantallas
    modifica la disposici\xF3n interna de los barrotes.\n\nAseg\xFArate de mantener
    un recorrido cerrado en todo momento.\n\nUn error aqu\xED no solo bloquea el
    acceso\u2026 tambi\xE9n puede abrirlo."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
