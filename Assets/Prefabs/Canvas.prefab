  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Fallo en el sistema auxiliar de apertura del sector.\n\nLos repuestos
    han sido trasladados del almac\xE9n al \xE1rea de descanso para su reparaci\xF3n
    manual.\n\nKarim ha tenido la brillante idea de esconder las piezas por las distintas
    salas del \xE1rea de descanso como \u201Cdespedida\u201D antes de su traslado.\n\nNo
    tengo energ\xEDas para ir a buscarlas. Que alguien las recupere y lo repare."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
