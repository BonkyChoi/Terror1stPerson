  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Querida madre,\n\nNo hace falta seguir fingiendo que esto es solo investigaci\xF3n.
    Los dos sabemos lo que es en realidad.\n\nEl mundo fuera sigue hablando de equilibrio,
    pero ese equilibrio ya no existe. Solo es cuesti\xF3n de tiempo.\n\nEl esp\xE9cimen
    no es un error. Es la confirmaci\xF3n de que todo esto ten\xEDa que llegar hasta
    aqu\xED.\n\nSiempre dec\xEDas que en la vida hay dos opciones: o act\xFAas, o
    eres aplastado por los que s\xED lo hacen. Aqu\xED lo estamos llevando a su forma
    m\xE1s real.\n\nSi ganas vives, si pierdes mueres, si no luchas no puedes ganar.
    Eso es lo \xFAnico que importa ahora mismo. Todo lo dem\xE1s son excusas.\n\nY
    t\xFA lo entiendes igual que yo.\n\nPor eso seguimos adelante.\n\nCuando todo
    termine no habr\xE1 dudas.\n\n\u2014 Eran"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
